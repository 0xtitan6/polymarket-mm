{
  "name": "sui-arbitrage",
  "version": "0.1.0",
  "description": "Automated arbitrage bot for Sui DEX ecosystem — detects and executes cross-DEX price discrepancies",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "sui",
    "arbitrage",
    "defi",
    "dex",
    "cetus",
    "turbos",
    "deepbook",
    "trading"
  ],
  "license": "MIT",
  "dependencies": {
    "@mysten/sui": "^1.21.0",
    "@cetusprotocol/cetus-sui-clmm-sdk": "^5.3.2",
    "bignumber.js": "^9.1.2",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
