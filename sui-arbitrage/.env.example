# Sui Network
SUI_RPC_URL=https://fullnode.mainnet.sui.io:443
SUI_NETWORK=mainnet

# Wallet (use ONLY one method)
SUI_PRIVATE_KEY=
# SUI_MNEMONIC=

# Trading Parameters
DRY_RUN=true
MIN_PROFIT_BPS=30
MAX_TRADE_SIZE_SUI=100
GAS_BUDGET=50000000

# DEX Configuration
CETUS_ENABLED=true
TURBOS_ENABLED=true
DEEPBOOK_ENABLED=true

# Monitoring
SCAN_INTERVAL_MS=1000
LOG_LEVEL=info

# Optional: WebSocket for real-time price feeds
PRICE_WS_ENABLED=false
